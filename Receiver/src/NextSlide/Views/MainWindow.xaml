<Window x:Class="NextSlide.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:converters="clr-namespace:NextSlide.Converters"
        mc:Ignorable="d"
        Title="{Binding AppName}"
        Icon="/Resources/app.ico"
        Height="680" Width="1040"
        MinHeight="500" MinWidth="820"
        WindowStartupLocation="CenterScreen"
        d:DesignHeight="680" d:DesignWidth="1040">

    <Window.Resources>
        <converters:OutcomeToBrushConverter x:Key="OutcomeToBrushConverter" />
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: monogram glyph, app name + subheader -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Width="32" Height="32" CornerRadius="10"
                    Background="{StaticResource Accent}" VerticalAlignment="Top">
                <TextBlock Text="{Binding Monogram}" FontWeight="Bold" FontSize="14"
                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding AppName}" FontSize="22" FontWeight="Bold" />
                <TextBlock Text="{Binding SubHeaderText}" FontSize="13"
                           Foreground="{StaticResource Text.Secondary}" Margin="0,2,0,0" />
            </StackPanel>
        </Grid>

        <!--
            Hookup panel — the three-step flow from the UI spec: lock a
            Session name, paste the Sheet URL (unlocked once Session is
            locked), pick a presentation to drive (unlocked once the Sheet
            URL looks usable). Each GroupBox's controls disable themselves
            via the view model's derived Is*Editable/Enabled properties
            rather than this view tracking the sequencing itself.
        -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="1 · Session" Margin="0,0,10,0">
                <StackPanel>
                    <TextBox Text="{Binding SessionName, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding IsSessionNameEditable}"
                             ToolTip="The same Session name entered on the remote — case-insensitive." />
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Lock" Command="{Binding LockSessionCommand}"
                                Style="{StaticResource Button.Primary}" Margin="0,0,6,0" />
                        <Button Grid.Column="1" Content="Release" Command="{Binding ReleaseSessionCommand}" Margin="6,0,0,0" />
                    </Grid>
                </StackPanel>
            </GroupBox>

            <GroupBox Grid.Column="1" Header="2 · Google Sheet URL" Margin="0,0,10,0">
                <StackPanel>
                    <TextBox Text="{Binding SheetUrl, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding IsSheetUrlEditable}"
                             ToolTip="Paste the sheet's normal share/edit link. Must be shared 'Anyone with the link can view'." />
                    <TextBlock Text="Kept if you release the session — only the Session field re-locks."
                               FontSize="11" Foreground="{StaticResource Text.Faint}"
                               Margin="0,10,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </GroupBox>

            <GroupBox Grid.Column="2" Header="3 · Hook to PowerPoint" Margin="0,0,0,0">
                <StackPanel>
                    <ComboBox ItemsSource="{Binding AvailablePresentations}"
                              SelectedItem="{Binding SelectedPresentation}"
                              IsEnabled="{Binding IsPresentationPickerEnabled}" />
                    <Button Content="Refresh" Command="{Binding RefreshPresentationsCommand}" Margin="0,10,0,0" />
                </StackPanel>
            </GroupBox>
        </Grid>

        <!-- Main content: command log, newest at the top. -->
        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding CommandLog}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Background" Value="{Binding Outcome, Converter={StaticResource OutcomeToBrushConverter}}" />
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Time" Binding="{Binding ProcessedAt, StringFormat={}{0:HH:mm:ss}}" Width="80">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Command" Binding="{Binding Command}" Width="120" />
                <DataGridTextColumn Header="Slide #" Binding="{Binding SlideNumber}" Width="70" />
                <DataGridTextColumn Header="Session" Binding="{Binding Session}" Width="140" />
                <DataGridTextColumn Header="Result" Binding="{Binding Outcome}" Width="90">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- Status bar: live lamp + status text, Clear Log. -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{StaticResource Text.Faint}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPolling}" Value="True">
                                    <Setter Property="Fill" Value="{StaticResource Status.Success}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource Text.Secondary}"
                           FontFamily="{StaticResource Font.Mono}" FontSize="12" VerticalAlignment="Center" />
            </StackPanel>

            <Button Grid.Column="1" Content="Clear Log" Command="{Binding ClearLogCommand}" />
        </Grid>
    </Grid>
</Window>
